# Production template — copy values into the host env / CI secrets, not into git.
# Domain placeholders only.

NEXT_PUBLIC_USE_API_MOCK=false
NEXT_PUBLIC_API_BASE_URL=https://webapp.carschek.com/api/v1
# Server-only; used by /api/v1 proxy. Defaults to NEXT_PUBLIC_API_BASE_URL.
API_UPSTREAM_URL=https://webapp.carschek.com/api/v1
NEXT_PUBLIC_API_USE_PROXY=true
NEXT_PUBLIC_ENABLE_AUTH_GUARD=true
NEXT_PUBLIC_DISABLE_MIDDLEWARE=false
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
NEXT_PUBLIC_SITE_URL=https://app.yourdomain.com
