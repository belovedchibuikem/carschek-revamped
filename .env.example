# Carschek frontend — local / shared template
# Copy to `.env.local` for development. Do not commit `.env` or `.env.local`.
# See also `.env.production.example` and docs/PRODUCTION.md

# false = call Laravel API; omit or "true" = in-browser mocks
NEXT_PUBLIC_USE_API_MOCK=false

# Laravel API v1 base (no trailing slash required). Browser traffic is proxied via /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Optional server-only override for the proxy (defaults to NEXT_PUBLIC_API_BASE_URL)
# API_UPSTREAM_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_API_USE_PROXY=true

# Cookie-based middleware guard for /dashboard (and related)
NEXT_PUBLIC_ENABLE_AUTH_GUARD=true

# Emergency bypass only — keep false in production
NEXT_PUBLIC_DISABLE_MIDDLEWARE=false

# Show login demo-account panel (dev default). In production builds, panel is hidden unless true.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Optional marketing / 3rd-party placeholders
# NEXT_PUBLIC_SITE_URL=https://app.yourdomain.com
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_ADSENSE_ID=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# OPENAI_API_KEY=
# CARSCHEK_VISION_API_KEY=   # optional alias for Phase 1 photo assist
# CARSCHEK_VISION_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=

# Phase 1 AI-ready (assisted UX — default on). Set false to hide a slice.
# NEXT_PUBLIC_PHASE1_OBSERVED_RISKS=true
# NEXT_PUBLIC_PHASE1_VALUATION_ASSIST=true
# NEXT_PUBLIC_PHASE1_VISION_ASSIST=true
